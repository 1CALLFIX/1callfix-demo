<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- Phase 22.1+ discovery: the default CLI memory_limit (128M, from
             php.ini) is no longer enough to run the full suite in one PHP
             process now that it has grown to 800+ tests, reproduced twice,
             always a Fatal "Allowed memory size exhausted" crash rendering
             Settings\Manage's large compiled view, at a different specific
             test each time (cumulative memory growth across many Livewire
             or Laravel TestCase boots hitting a fixed ceiling, not a leak
             tied to any one test). Confirmed NOT caused by this session's
             new tests: the identical commit passed 805/805 cleanly once,
             then crashed on a later re-run with zero code changes made in
             between. 512M is a generous, standard bump for a suite this
             size; test infrastructure only, zero effect on the real app's
             runtime memory_limit in dev or production. -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:Pl17tPes0CiW1JSYeYd0DjnY+F8QRf5tAAlmEVHYn0g="/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
