# LiteSpeed's own page cache (2026-11-08): only answers PHP has marked with X-LiteSpeed-Cache-Control are kept.
<IfModule LiteSpeed>
    CacheLookup on
    RewriteEngine On
    # Signed in or something personal (cf_nc), a zone (cf_zone), a chosen language (cf_locale) or our Android apps:
    # never a saved copy, always PHP (app/Support/LiteSpeed.php).
    RewriteCond %{HTTP_COOKIE} (^|;\s*)(cf_nc|cf_zone|cf_locale)= [OR]
    RewriteCond %{HTTP_USER_AGENT} 1CallFixApp
    RewriteRule .* - [E=Cache-Control:no-cache]
</IfModule>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Speed: Vite build files carry a content hash in their name, so they can be cached
    # for a year and never revalidated. Only /build/assets/ — never manifest.json.
    RewriteRule ^build/assets/ - [E=ONECF_IMMUTABLE_ASSET:1]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable" env=ONECF_IMMUTABLE_ASSET
</IfModule>
