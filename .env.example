# ============================================================================
# PRODUCTION DEPLOYMENT — REQUIRED OVERRIDES
# ============================================================================
# The defaults below (APP_ENV=local, APP_DEBUG=true) are correct for local
# development ONLY. This is exactly how the real production incident this
# repo already tracks happened — see KNOWN_RISKS_AND_DECISIONS.md item 25:
# production's own .env had APP_DEBUG=true, confirmed via direct SSH,
# exposing full stack traces on every unhandled 500 until fixed in place.
# Every real deploy MUST explicitly set, on the server's own .env (never
# committed):
#   APP_ENV=production
#   APP_DEBUG=false
#   APP_KEY=<a real, unique, never-committed key — see below>
#   SESSION_SECURE_COOKIE=true   (cookie only sent over HTTPS)
# See docs/DEPLOYMENT_RUNBOOK.md's pre-deploy checklist, which checks this
# explicitly rather than assuming it.
# ============================================================================
APP_NAME=Laravel
APP_ENV=local
# APP_KEY is REQUIRED, must be unique PER ENVIRONMENT, and must NEVER be
# committed — generate on the target server itself with `php artisan
# key:generate`, never copy one environment's key into another (doing so
# would let one environment decrypt/forge the other's encrypted cookies,
# signed URLs, and any encrypted database column).
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# LOG_STACK=single (the local-dev default below) writes to ONE
# storage/logs/laravel.log file that grows forever -- fine for a throwaway
# dev environment, a real availability risk on a production disk with no
# rotation. Production MUST set LOG_STACK=daily (Laravel's own daily-
# rotating driver, config/logging.php already defaults its retention to 14
# days via LOG_DAILY_DAYS) so logs never grow unbounded. See
# docs/DEPLOYMENT_RUNBOOK.md.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# config/session.php's own 'secure' key has no hardcoded fallback (reads
# this env var directly, defaulting to PHP null if unset) -- null does NOT
# mean "secure", it means Laravel lets the cookie go out over plain HTTP
# too. Production (served over HTTPS at api.1callfix.com) MUST set this to
# true; local dev over plain http://localhost must leave it unset/false.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

GOOGLE_MAPS_API_KEY=

# Razorpay — the real, already-selected payment provider (see
# app/Providers/AppServiceProvider.php's PaymentGateway binding and
# app/Services/RazorpayService.php). config/services.php has read
# RAZORPAY_KEY_ID/RAZORPAY_KEY_SECRET/RAZORPAY_WEBHOOK_SECRET since payments
# were built, but no line for any of the three ever existed in this file —
# a real production-hardening gap this session found: a deploy engineer
# following only this template would have no idea these three were
# required at all. Never commit real values here; set them directly on the
# target server's own .env.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# BD-8 -- real SMS/push delivery. Both left unset (driver defaults to
# 'log', see config/services.php) since no real credentials exist in this
# repository/environment -- see KNOWN_RISKS_AND_DECISIONS.md item 8.
# 'arkesel' is the confirmed-working provider for this business (real
# credentials found populated in the Glover 1.8.5 reference deployment's
# own environment, unlike msg91/gatewayapi below, which are equally-ready
# but were never confirmed live) -- set SMS_DRIVER=arkesel plus
# ARKESEL_API_KEY/ARKESEL_SENDER with this business's real Arkesel account
# credentials to activate it. Never commit real values here.
SMS_DRIVER=log
# ARKESEL_API_KEY=
# ARKESEL_SENDER=
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=
# MSG91_ROUTE=4
# GATEWAYAPI_TOKEN=
# GATEWAYAPI_SENDER=
# Default calling code used to reconcile a Firebase E.164 number with the
# bare national numbers this app stores (India).
# SMS_COUNTRY_CODE=91

# Firebase Authentication (auth rebuild — password-first login, OTP as
# verification only). The customer web app does phone-OTP and Google
# sign-in with the Firebase JS SDK; the server re-verifies the resulting
# ID token (App\Services\Auth\GoogleFirebaseTokenVerifier, using
# firebase/php-jwt against Google's public certs — kreait/firebase-php is
# not installable here: it needs ext-sodium).
#
# Server-side: only FIREBASE_PROJECT_ID is used (the ID token's aud/iss
# must equal it). The FIREBASE_WEB_* values are the PUBLIC Firebase web
# config (not secrets) shipped to the browser; the Vite bundle reads them
# as VITE_FIREBASE_* at build time (see resources/js/customer-auth.js).
# The Firebase project must be on the Blaze plan for phone-auth SMS, and
# the deployed host added under Authentication → Settings → Authorized
# domains. No service-account JSON is needed for token verification.
# FIREBASE_PROJECT_ID=
# FIREBASE_WEB_API_KEY=
# FIREBASE_WEB_AUTH_DOMAIN=
# FIREBASE_WEB_APP_ID=
# FIREBASE_WEB_MESSAGING_SENDER_ID=
# FIREBASE_WEB_STORAGE_BUCKET=
# VITE_FIREBASE_API_KEY="${FIREBASE_WEB_API_KEY}"
# VITE_FIREBASE_AUTH_DOMAIN="${FIREBASE_WEB_AUTH_DOMAIN}"
# VITE_FIREBASE_PROJECT_ID="${FIREBASE_PROJECT_ID}"
# VITE_FIREBASE_APP_ID="${FIREBASE_WEB_APP_ID}"
# VITE_FIREBASE_MESSAGING_SENDER_ID="${FIREBASE_WEB_MESSAGING_SENDER_ID}"
# VITE_FIREBASE_STORAGE_BUCKET="${FIREBASE_WEB_STORAGE_BUCKET}"

# Firebase Cloud Messaging -- FCM_CREDENTIALS_JSON expects the full
# service-account JSON as a single-line value (or use FCM_CREDENTIALS_PATH
# to point at a file instead, never committed). This business has a real,
# non-expired Firebase service account in the Glover 1.8.5 reference
# deployment (storage/app/vault/firebase_service.json there) -- do NOT
# copy that file's contents into this repository or paste them into any
# tool output; provision this app's own Firebase project/service-account
# (or deliberately reuse that one) directly on the target server's secure
# environment instead. See KNOWN_RISKS_AND_DECISIONS.md item 8.
PUSH_DRIVER=log
# FCM_PROJECT_ID=
# FCM_CREDENTIALS_PATH=
# FCM_CREDENTIALS_JSON=

# Admin Polish + AI session -- Daily Insights digest / natural-language
# filter phrasing. Left unset (driver defaults to 'log', see
# config/services.php) since no real Anthropic API key exists in this
# repository/environment -- both features already work fully without one
# (real detection + a deterministic fact list / filter parse), just without
# LLM-phrased prose. Set AI_DRIVER=anthropic plus ANTHROPIC_API_KEY with a
# real key to activate. Never commit a real key here.
AI_DRIVER=log
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

VITE_APP_NAME="${APP_NAME}"
