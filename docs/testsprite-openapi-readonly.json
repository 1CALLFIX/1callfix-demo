{
  "openapi": "3.0.3",
  "info": {
    "title": "1CallFix API (read-only test subset)",
    "version": "1.0"
  },
  "servers": [
    {
      "url": "https://api.1callfix.com"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "paths": {
    "/api/auth/password": {
      "post": {
        "summary": "Password login; returns a Sanctum bearer token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "identifier",
                  "password",
                  "actor_type"
                ],
                "properties": {
                  "identifier": {
                    "type": "string",
                    "description": "mobile number or email"
                  },
                  "password": {
                    "type": "string"
                  },
                  "actor_type": {
                    "type": "string",
                    "example": "customer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token issued"
          },
          "422": {
            "description": "Validation error"
          },
          "429": {
            "description": "Throttled (5 attempts)"
          }
        }
      }
    },
    "/api/banners": {
      "get": {
        "summary": "Active banners",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/categories": {
      "get": {
        "summary": "Service categories",
        "responses": {
